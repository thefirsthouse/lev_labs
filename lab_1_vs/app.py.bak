from __future__ import annotations

import math
import tkinter as tk
from tkinter import ttk, messagebox
from collections import Counter
from fractions import Fraction

from lab1.entities import TaskType
from lab1.scheduler import SimulationConfig
from lab1.simulator import Simulator
from lab1.trace import ResourceEvent

TASK_NAMES = {
    "MDO": "МДО",
    "MSO": "МСО",
    "UPR": "Управление",
    "DISP": "Диспетчеризация",
}

TASK_COLORS = {
    "MDO": "#6d8cff",
    "MSO": "#67c59b",
    "UPR": "#e4a05b",
    "DISP": "#c186e6",
}

GROUP_COLORS = {
    "lookup": "#4f8fb8",
    "cache": "#4f9d87",
    "cache_hit": "#4aa77d",
    "cache_miss": "#d06464",
    "transfer": "#d79252",
    "bus": "#d3a249",
    "memory": "#9b79d8",
    "uso": "#d97895",
    "wait": "#666b78",
    "neutral": "#5d6370",
}

LANES = [
    ("PIPELINE_1", "КОНВЕЙЕР 1"),
    ("PIPELINE_2", "КОНВЕЙЕР 2"),
    ("CACHE", "КЭШ"),
    ("CACHE_CONTROLLER", "КЭШ-КОНТРОЛЛЕР"),
    ("SYSTEM_BUS", "СШ"),
    ("BUFFER_ELEMENT", "БЭ"),
    ("MEMORY", "ОП"),
    ("USO", "УСО"),
]
LANE_INDEX = {key: i for i, (key, _) in enumerate(LANES)}


class TimelineCanvas(tk.Frame):
    """Resource-oriented time diagram.

    Y = hardware resource. X = MP ticks. A block is one real ResourceEvent.
    command_id only links blocks belonging to the same command.
    """

    def __init__(self, master, on_event_click, **kwargs):
        super().__init__(master, **kwargs)
        self.on_event_click = on_event_click
        self.zoom_x = 14.0
        self.lane_height = 64
        self.block_padding = 7
        self.left_label_width = 155
        self.top_axis_height = 58
        self.events: list[ResourceEvent] = []
        self.current_tick = 0
        self._tooltip = None
        self._last_width = 1200

        self.canvas = tk.Canvas(self, background="#15181d", highlightthickness=0)
        self.hbar = ttk.Scrollbar(self, orient="horizontal", command=self.canvas.xview)
        self.vbar = ttk.Scrollbar(self, orient="vertical", command=self.canvas.yview)
        self.canvas.configure(xscrollcommand=self.hbar.set, yscrollcommand=self.vbar.set)
        self.canvas.grid(row=0, column=0, sticky="nsew")
        self.vbar.grid(row=0, column=1, sticky="ns")
        self.hbar.grid(row=1, column=0, sticky="ew")
        self.columnconfigure(0, weight=1)
        self.rowconfigure(0, weight=1)

        self.canvas.bind("<MouseWheel>", self._wheel)
        self.canvas.bind("<Button-4>", lambda e: self.canvas.yview_scroll(-1, "units"))
        self.canvas.bind("<Button-5>", lambda e: self.canvas.yview_scroll(1, "units"))
        self.canvas.bind("<Control-KeyPress-plus>", lambda e: self.adjust_zoom(1.2))
        self.canvas.bind("<Control-KeyPress-equal>", lambda e: self.adjust_zoom(1.2))
        self.canvas.bind("<Control-KeyPress-minus>", lambda e: self.adjust_zoom(1 / 1.2))

    def _wheel(self, event):
        # Ctrl + wheel = horizontal zoom. Plain wheel = vertical scroll.
        if event.state & 0x0004:
            self.adjust_zoom(1.15 if event.delta > 0 else 1 / 1.15)
        else:
            units = -1 if event.delta > 0 else 1
            self.canvas.yview_scroll(units, "units")

    def adjust_zoom(self, factor: float):
        self.zoom_x = min(36.0, max(6.0, self.zoom_x * factor))
        self.redraw()

    def set_zoom(self, value: float):
        self.zoom_x = min(36.0, max(6.0, float(value)))
        self.redraw()

    def set_lane_height(self, value: float):
        self.lane_height = min(120, max(42, float(value)))
        self.redraw()

    def set_data(self, events: list[ResourceEvent], current_tick: int):
        self.events = list(events)
        self.current_tick = current_tick
        self.redraw()

    def _x(self, tick: float) -> float:
        return self.left_label_width + tick * self.zoom_x

    @staticmethod
    def _make_slots(events: list[ResourceEvent]):
        slots: dict[str, list[float]] = {}
        assignments: dict[int, int] = {}
        for idx, ev in sorted(enumerate(events), key=lambda x: (float(x[1].start), float(x[1].end))):
            slots.setdefault(ev.resource, [])
            placed = False
            for slot_idx, end_list in enumerate(slots[ev.resource]):
                if all(float(ev.start) >= end - 1e-9 for end in end_list):
                    end_list.append(float(ev.end))
                    assignments[idx] = slot_idx
                    placed = True
                    break
            if not placed:
                slots[ev.resource].append([float(ev.end)])
                assignments[idx] = len(slots[ev.resource]) - 1
        return assignments, {k: len(v) for k, v in slots.items()}

    def redraw(self):
        self.canvas.delete("all")
        self._hide_tooltip()

        assignments, slot_counts = self._make_slots(self.events)
        max_tick = max(float(self.current_tick) + 20.0, 20.0)
        for ev in self.events:
            max_tick = max(max_tick, float(ev.end) + 4.0)
        width = int(self._x(max_tick) + 100)
        height = int(self.top_axis_height + len(LANES) * self.lane_height + 12)
        self._last_width = width

        # Lane backgrounds / labels.
        for i, (_, title) in enumerate(LANES):
            y0 = self.top_axis_height + i * self.lane_height
            y1 = y0 + self.lane_height
            fill = "#1a1d23" if i % 2 == 0 else "#171a20"
            self.canvas.create_rectangle(0, y0, width, y1, fill=fill, outline="")
            self.canvas.create_text(
                10, (y0 + y1) / 2, text=title, anchor="w",
                fill="#d8dde6", font=("TkDefaultFont", 10, "bold"),
            )
            self.canvas.create_line(self.left_label_width, y0, width, y0, fill="#343943")

        # Time grid.
        integer_max = math.ceil(max_tick)
        for tick in range(integer_max + 1):
            x = self._x(tick)
            if tick % 10 == 0:
                color, dash, width_line = "#687080", None, 1
                self.canvas.create_text(
                    x + 3, 17, text=str(tick), anchor="w",
                    fill="#e0e5ec", font=("TkDefaultFont", 9, "bold"),
                )
            elif tick % 5 == 0:
                color, dash, width_line = "#4b525e", None, 1
            else:
                color, dash, width_line = "#30353e", (2, 3), 1
            self.canvas.create_line(x, self.top_axis_height, x, height, fill=color, dash=dash, width=width_line)

        self.canvas.create_text(
            10, 17, text="ВРЕМЯ (ТАКТЫ МП)", anchor="w",
            fill="#91c9e4", font=("TkDefaultFont", 9, "bold"),
        )
        self.canvas.create_text(
            self.left_label_width + 4, 39,
            text="1 такт СШ ≈ 2,63 такта МП | блок = реальная операция ресурса",
            anchor="w", fill="#858d9b", font=("TkDefaultFont", 8),
        )

        # Current tick marker.
        now_x = self._x(self.current_tick)
        self.canvas.create_line(now_x, self.top_axis_height - 4, now_x, height, fill="#f3dc7a", width=2)
        self.canvas.create_text(
            now_x + 5, 39, text=f"NOW {self.current_tick}", anchor="w",
            fill="#f3dc7a", font=("TkDefaultFont", 8, "bold"),
        )

        # Connect different resources used by the same command.
        by_command: dict[int, list[ResourceEvent]] = {}
        for ev in self.events:
            if ev.command_id is not None:
                by_command.setdefault(ev.command_id, []).append(ev)
        for cmd_id, evs in by_command.items():
            evs.sort(key=lambda e: (float(e.start), float(e.end), LANE_INDEX.get(e.resource, 999)))
            for a, b in zip(evs, evs[1:]):
                if a.resource == b.resource:
                    continue
                ay = self.top_axis_height + (LANE_INDEX[a.resource] + 0.5) * self.lane_height
                by = self.top_axis_height + (LANE_INDEX[b.resource] + 0.5) * self.lane_height
                ax = self._x(float(a.end))
                bx = self._x(float(b.start))
                if bx < ax:
                    # Overlapping activities of the same command are allowed in the trace.
                    continue
                self.canvas.create_line(ax, ay, bx, by, fill="#6f7786", dash=(3, 4), arrow="last")

        # Draw blocks.
        for idx, ev in enumerate(self.events):
            lane = LANE_INDEX.get(ev.resource)
            if lane is None:
                continue
            y0 = self.top_axis_height + lane * self.lane_height
            slots = slot_counts.get(ev.resource, 1)
            slot = assignments.get(idx, 0)
            available = self.lane_height - 2 * self.block_padding - max(0, slots - 1) * 3
            slot_h = max(18.0, min(40.0, available / max(1, slots)))
            y = y0 + self.block_padding + slot * (slot_h + 3)
            x0 = self._x(float(ev.start))
            x1 = self._x(float(ev.end))
            if x1 - x0 < 5:
                x1 = x0 + 5

            if ev.resource.startswith("PIPELINE") and ev.operation == "EXECUTE":
                fill = TASK_COLORS.get(ev.task or "", GROUP_COLORS["neutral"])
            else:
                fill = GROUP_COLORS.get(ev.color_group, GROUP_COLORS["neutral"])

            tag = f"event_{idx}"
            self.canvas.create_rectangle(
                x0 + 1, y, x1 - 1, y + slot_h,
                fill=fill, outline="#0e1115", width=1, tags=(tag,),
            )

            # Split memory/buffer transfer visually into 4-1-1-1 sections.
            if ev.resource in {"MEMORY", "BUFFER_ELEMENT", "SYSTEM_BUS"} and ev.operation in {"READ", "BUFFER", "MEMORY TRANSFER"} and ev.duration >= 4:
                # ev duration is stored in MP-time; the first 4 SB ticks and next 1,1,1 are
                # converted to MP-time using the same exact factor as the simulator.
                seg_lengths = [4, 1, 1, 1]
                total_sb = sum(seg_lengths)
                for sb_off in (4, 5, 6):
                    xx = x0 + (x1 - x0) * sb_off / total_sb
                    self.canvas.create_line(xx, y + 2, xx, y + slot_h - 2, fill="#343a45", width=1, tags=(tag,))

            label = ev.operation
            if ev.resource.startswith("PIPELINE") and ev.command_id is not None:
                label = f"{TASK_NAMES.get(ev.task, ev.task or '—')} #{ev.command_id}"
            elif ev.resource == "CACHE" and ev.operation in {"HIT", "MISS"} and ev.command_id is not None:
                label = f"{ev.operation} #{ev.command_id}"
            if x1 - x0 > 44:
                self.canvas.create_text(
                    x0 + 5, y + slot_h / 2, text=label, anchor="w",
                    fill="#111318", font=("TkDefaultFont", 8, "bold"), tags=(tag,),
                )

            self.canvas.tag_bind(tag, "<Button-1>", lambda e, event=ev: self.on_event_click(event))
            self.canvas.tag_bind(tag, "<Enter>", lambda e, event=ev: self._show_tooltip(event, e.x_root, e.y_root))
            self.canvas.tag_bind(tag, "<Leave>", lambda e: self._hide_tooltip())

        self.canvas.configure(scrollregion=(0, 0, width, height))

    def _show_tooltip(self, ev: ResourceEvent, x: int, y: int):
        self._hide_tooltip()
        tip = tk.Toplevel(self)
        tip.wm_overrideredirect(True)
        tip.configure(bg="#0d1014")
        task = f"{TASK_NAMES.get(ev.task, ev.task)} #{ev.command_id}" if ev.command_id is not None else "—"
        text = (
            f"Ресурс: {dict(LANES)[ev.resource]}\n"
            f"Операция: {ev.operation}\n"
            f"Команда: {task}\n"
            f"МП: {float(ev.start):g} → {float(ev.end):g}\n"
            f"Длительность: {float(ev.duration):g} такта МП\n"
            f"{ev.detail}"
        )
        tk.Label(
            tip, text=text, justify="left", bg="#0d1014", fg="#eef2f7",
            padx=8, pady=7, font=("TkDefaultFont", 9),
        ).pack()
        tip.geometry(f"+{x+12}+{y+12}")
        self._tooltip = tip

    def _hide_tooltip(self):
        if self._tooltip is not None:
            try:
                self._tooltip.destroy()
            except tk.TclError:
                pass
            self._tooltip = None


class LabApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Имитационная модель ВС — Вариант 3")
        self.geometry("1500x920")
        self.minsize(1200, 760)
        self.configure(bg="#111317")

        self.sim: Simulator | None = None
        self._running = False
        self._after_id = None
        self.mode = tk.StringVar(value="full")
        self.cache_hit = tk.DoubleVar(value=0.65)
        self.seed_var = tk.IntVar(value=42)
        self.period_var = tk.IntVar(value=120)
        self.zoom_var = tk.StringVar(value="100%")
        self.thickness_var = tk.IntVar(value=64)
        self.phase_var = tk.StringVar(value="Фаза: —")
        self.status_var = tk.StringVar(value="Создай симуляцию")

        self.test_commands: list[tuple[TaskType, int]] = [
            (TaskType.MDO, 5),
            (TaskType.MSO, 2),
            (TaskType.UPR, 2),
            (TaskType.DISP, 1),
        ]

        self._styles()
        self._layout()
        self.create_simulation()

    def _styles(self):
        style = ttk.Style(self)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass
        style.configure("TFrame", background="#171a20")
        style.configure("Panel.TFrame", background="#171a20")
        style.configure("TLabel", background="#171a20", foreground="#d8dde6")
        style.configure("Header.TLabel", background="#171a20", foreground="#e6eaf0", font=("TkDefaultFont", 10, "bold"))
        style.configure("TButton", padding=(8, 5))
        style.configure("TCheckbutton", background="#171a20", foreground="#d8dde6")
        style.configure("TRadiobutton", background="#171a20", foreground="#d8dde6")
        style.configure("TScale", background="#171a20")

    def _layout(self):
        top = ttk.Frame(self, style="Panel.TFrame")
        top.pack(fill="x", padx=10, pady=(8, 6))
        ttk.Button(top, text="▶ Старт", command=self.start_run).pack(side="left", padx=(0, 6))
        ttk.Button(top, text="Ⅱ Пауза", command=self.pause_run).pack(side="left", padx=6)
        ttk.Button(top, text="⏭ Следующий такт", command=self.step_once).pack(side="left", padx=6)
        ttk.Button(top, text="⤺ Сброс", command=self.reset_sim).pack(side="left", padx=6)
        ttk.Button(top, text="⏩ До следующей фазы", command=self.next_phase).pack(side="left", padx=6)
        ttk.Label(top, text="Период (мс):").pack(side="left", padx=(16, 4))
        ttk.Spinbox(top, from_=10, to=2000, textvariable=self.period_var, width=7).pack(side="left")
        ttk.Label(top, textvariable=self.phase_var, font=("TkDefaultFont", 10, "bold")).pack(side="right", padx=10)

        outer = ttk.Frame(self, style="Panel.TFrame")
        outer.pack(fill="both", expand=True, padx=10)
        outer.columnconfigure(1, weight=1)
        outer.rowconfigure(0, weight=1)

        left = ttk.Frame(outer, style="Panel.TFrame", width=300)
        left.grid(row=0, column=0, sticky="nsw", padx=(0, 8))
        left.grid_propagate(False)
        center = ttk.Frame(outer, style="Panel.TFrame")
        center.grid(row=0, column=1, sticky="nsew")
        center.columnconfigure(0, weight=1)
        center.rowconfigure(1, weight=1)
        right = ttk.Frame(outer, style="Panel.TFrame", width=330)
        right.grid(row=0, column=2, sticky="nse", padx=(8, 0))
        right.grid_propagate(False)

        self._build_left(left)

        summary = ttk.Frame(center, style="Panel.TFrame")
        summary.grid(row=0, column=0, sticky="ew", pady=(0, 6))
        self.flow_label = ttk.Label(summary, text="Поток: —", font=("TkDefaultFont", 9, "bold"))
        self.flow_label.pack(side="left")
        ttk.Label(summary, textvariable=self.status_var, foreground="#858d9b").pack(side="right")

        self.timeline = TimelineCanvas(center, self._event_clicked)
        self.timeline.grid(row=1, column=0, sticky="nsew")
        self._build_right(right)

        self.protocol("WM_DELETE_WINDOW", self._on_close)

    def _build_left(self, frame):
        ttk.Label(frame, text="РЕЖИМ", style="Header.TLabel").pack(anchor="w", pady=(4, 6))
        ttk.Radiobutton(frame, text="Полная симуляция — вариант 3", variable=self.mode, value="full").pack(anchor="w")
        ttk.Radiobutton(frame, text="Тестовый режим", variable=self.mode, value="test").pack(anchor="w", pady=(0, 10))

        ttk.Label(frame, text="КЭШ", style="Header.TLabel").pack(anchor="w", pady=(4, 6))
        c = ttk.Frame(frame, style="Panel.TFrame")
        c.pack(fill="x")
        ttk.Radiobutton(c, text="65%", variable=self.cache_hit, value=0.65).pack(side="left")
        ttk.Radiobutton(c, text="85%", variable=self.cache_hit, value=0.85).pack(side="left", padx=10)

        ttk.Label(frame, text="SEED", style="Header.TLabel").pack(anchor="w", pady=(14, 6))
        ttk.Entry(frame, textvariable=self.seed_var, width=12).pack(anchor="w")

        ttk.Label(frame, text="ПОТОК ВАРИАНТА 3", style="Header.TLabel").pack(anchor="w", pady=(14, 6))
        self.generated_label = ttk.Label(frame, text="МДО 30 | МСО 40 | УПР 30 | Дисп 10–70", justify="left")
        self.generated_label.pack(anchor="w")

        ttk.Label(frame, text="ТЕСТОВЫЕ КОМАНДЫ", style="Header.TLabel").pack(anchor="w", pady=(14, 6))
        add = ttk.Frame(frame, style="Panel.TFrame")
        add.pack(fill="x")
        self.test_task = ttk.Combobox(add, values=["МДО", "МСО", "Управление", "Диспетчеризация"], state="readonly", width=15)
        self.test_task.set("МДО")
        self.test_task.pack(side="left")
        self.test_dur = tk.IntVar(value=2)
        ttk.Spinbox(add, from_=1, to=5, textvariable=self.test_dur, width=4).pack(side="left", padx=4)
        ttk.Button(add, text="+", width=3, command=self.add_test_command).pack(side="left")
        self.test_tree = ttk.Treeview(frame, columns=("task", "dur"), show="headings", height=6)
        self.test_tree.heading("task", text="Тип")
        self.test_tree.heading("dur", text="Такты")
        self.test_tree.column("task", width=150)
        self.test_tree.column("dur", width=60, anchor="center")
        self.test_tree.pack(fill="x", pady=6)
        ttk.Button(frame, text="Удалить выбранную", command=self.remove_test_command).pack(anchor="e")

        ttk.Button(frame, text="Создать симуляцию", command=self.create_simulation).pack(fill="x", pady=(16, 5))
        ttk.Button(frame, text="Очистить диаграмму", command=self.clear_timeline).pack(fill="x")

        ttk.Label(frame, text="МАСШТАБ ПО X", style="Header.TLabel").pack(anchor="w", pady=(16, 4))
        zrow = ttk.Frame(frame, style="Panel.TFrame")
        zrow.pack(fill="x")
        ttk.Button(zrow, text="−", width=3, command=lambda: self.adjust_zoom(1 / 1.25)).pack(side="left")
        ttk.Label(zrow, textvariable=self.zoom_var, width=8, anchor="center").pack(side="left")
        ttk.Button(zrow, text="+", width=3, command=lambda: self.adjust_zoom(1.25)).pack(side="left")
        ttk.Button(zrow, text="100%", command=lambda: self.set_zoom_percent(100)).pack(side="left", padx=5)
        ttk.Button(zrow, text="200%", command=lambda: self.set_zoom_percent(200)).pack(side="left")
        ttk.Label(frame, text="Ctrl + колесо / Ctrl +/- тоже меняют масштаб", foreground="#858d9b").pack(anchor="w", pady=(3, 0))

        ttk.Label(frame, text="ТОЛЩИНА БЛОКОВ", style="Header.TLabel").pack(anchor="w", pady=(14, 4))
        thick = ttk.Scale(frame, from_=42, to=100, variable=self.thickness_var, command=self._thickness_changed)
        thick.pack(fill="x")
        self.thick_label = ttk.Label(frame, text="64 px")
        self.thick_label.pack(anchor="w")

        ttk.Label(frame, text="Смысл диаграммы", style="Header.TLabel").pack(anchor="w", pady=(14, 4))
        ttk.Label(
            frame,
            text="Строка = ресурс.\nX = время.\nБлок = конкретное использование ресурса.\n\nОдна команда может иметь несколько блоков на разных строках.",
            foreground="#9aa2b0", justify="left",
        ).pack(anchor="w")
        self.refresh_test_tree()

    def _build_right(self, frame):
        ttk.Label(frame, text="ТЕКУЩЕЕ СОСТОЯНИЕ", style="Header.TLabel").pack(anchor="w")
        self.snapshot = tk.Text(frame, height=17, bg="#101318", fg="#dde3ec", relief="flat", wrap="word")
        self.snapshot.pack(fill="x", pady=(6, 12))
        self.snapshot.configure(state="disabled")

        ttk.Label(frame, text="СОБЫТИЕ", style="Header.TLabel").pack(anchor="w")
        self.detail = tk.Text(frame, height=8, bg="#101318", fg="#dde3ec", relief="flat", wrap="word")
        self.detail.pack(fill="x", pady=(6, 12))
        self.detail.configure(state="disabled")

        ttk.Label(frame, text="СТАТИСТИКА", style="Header.TLabel").pack(anchor="w")
        self.stats_label = ttk.Label(frame, text="—", justify="left")
        self.stats_label.pack(anchor="w", pady=(6, 12))

        ttk.Label(frame, text="ПОСЛЕДНИЕ СОБЫТИЯ", style="Header.TLabel").pack(anchor="w")
        self.log = tk.Text(frame, height=16, bg="#101318", fg="#aeb6c5", relief="flat", wrap="word")
        self.log.pack(fill="both", expand=True, pady=(6, 0))
        self.log.configure(state="disabled")

    def _thickness_changed(self, value):
        v = int(float(value))
        self.timeline.set_lane_height(v)
        self.thick_label.configure(text=f"{v} px")

    def set_zoom_percent(self, pct: float):
        self.timeline.set_zoom(14.0 * pct / 100.0)
        self.zoom_var.set(f"{pct:.0f}%")

    def adjust_zoom(self, factor: float):
        self.timeline.adjust_zoom(factor)
        self.zoom_var.set(f"{self.timeline.zoom_x / 14.0 * 100:.0f}%")

    def add_test_command(self):
        mapping = {"МДО": TaskType.MDO, "МСО": TaskType.MSO, "Управление": TaskType.UPR, "Диспетчеризация": TaskType.DISP}
        self.test_commands.append((mapping[self.test_task.get()], int(self.test_dur.get())))
        self.refresh_test_tree()

    def remove_test_command(self):
        selected = self.test_tree.selection()
        if not selected:
            return
        for idx in sorted((self.test_tree.index(item) for item in selected), reverse=True):
            self.test_commands.pop(idx)
        self.refresh_test_tree()

    def refresh_test_tree(self):
        for item in self.test_tree.get_children():
            self.test_tree.delete(item)
        for task, dur in self.test_commands:
            self.test_tree.insert("", "end", values=(TASK_NAMES[task.name], dur))

    def make_cfg(self):
        return SimulationConfig(seed=int(self.seed_var.get()), p_hit=float(self.cache_hit.get()))

    def create_simulation(self):
        try:
            cfg = self.make_cfg()
        except (tk.TclError, ValueError):
            messagebox.showerror("Ошибка", "Seed должен быть целым числом.")
            return
        self.pause_run()
        self.sim = Simulator(cfg)
        if self.mode.get() == "full":
            self.sim.generate_variant3()
        else:
            self.sim.generate_test(self.test_commands)
        self._sync_ui()
        self.status_var.set(f"Создано команд: {len(self.sim.command_stream)}")

    def reset_sim(self):
        self.create_simulation()
        self.status_var.set("Симуляция сброшена")

    def clear_timeline(self):
        if self.sim:
            self.sim.trace_events.clear()
        self.timeline.set_data([], 0)
        self.status_var.set("Диаграмма очищена")

    def start_run(self):
        if self.sim is None:
            self.create_simulation()
        if self.sim is None or self.sim.finished or self._running:
            return
        self._running = True
        self.status_var.set("Симуляция выполняется…")
        self._after_id = self.after(max(10, int(self.period_var.get())), self._auto_step)

    def _auto_step(self):
        self._after_id = None
        if not self._running or self.sim is None:
            return
        if self.sim.finished:
            self._running = False
            self._sync_ui()
            return
        self.sim.step()
        self._sync_ui(auto_scroll=True)
        if not self.sim.finished and self._running:
            self._after_id = self.after(max(10, int(self.period_var.get())), self._auto_step)
        else:
            self._running = False
            self.status_var.set("Симуляция завершена")

    def pause_run(self):
        self._running = False
        if self._after_id is not None:
            try:
                self.after_cancel(self._after_id)
            except tk.TclError:
                pass
            self._after_id = None

    def step_once(self):
        self.pause_run()
        if self.sim is None:
            self.create_simulation()
        if self.sim is None or self.sim.finished:
            return
        self.sim.step()
        self._sync_ui(auto_scroll=True)
        self.status_var.set("Выполнен один такт")

    def next_phase(self):
        """Advance until a new task type appears in a pipeline, then stop."""
        self.pause_run()
        if self.sim is None:
            self.create_simulation()
        if self.sim is None or self.sim.finished:
            return
        before = self._active_task_names()
        guard = 0
        while not self.sim.finished and guard < 20000:
            self.sim.step()
            guard += 1
            after = self._active_task_names()
            if any(t not in before for t in after):
                break
        self._sync_ui(auto_scroll=True)
        self.status_var.set("Остановлено на следующей фазе")

    def _active_task_names(self):
        if self.sim is None:
            return set()
        return {p.command.task.name for p in self.sim.pipelines if p.command is not None}

    def _current_phase(self) -> str:
        if self.sim is None:
            return "Фаза: —"
        active = self._active_task_names()
        if active:
            return "Фаза: " + ", ".join(TASK_NAMES.get(x, x) for x in sorted(active))
        if self.sim.stream_index < len(self.sim.command_stream):
            return "Следующая: " + TASK_NAMES.get(self.sim.command_stream[self.sim.stream_index].task.name, "—")
        return "Фаза: завершено"

    def _sync_ui(self, auto_scroll=False):
        if self.sim is None:
            return
        self.timeline.set_data(self.sim.trace_events, self.sim.current_tick)
        self._set_text(self.snapshot, self.sim.snapshot())
        stats = self.sim.stats
        counts = Counter(c.task.name for c in self.sim.command_stream)
        issued = Counter(c.task.name for c in self.sim.command_stream if c.status != "WAITING")
        done = Counter(c.task.name for c in self.sim.command_stream if c.status == "DONE")
        disp_count = counts.get("DISP", 0)
        self.flow_label.configure(
            text=(
                f"Поток: МДО {counts.get('MDO', 0)} → МСО {counts.get('MSO', 0)} → "
                f"УПР {counts.get('UPR', 0)} → Дисп {disp_count}   |   "
                f"Введено: {issued.get('MDO',0)}/{issued.get('MSO',0)}/{issued.get('UPR',0)}/{issued.get('DISP',0)}   "
                f"Готово: {done.get('MDO',0)}/{done.get('MSO',0)}/{done.get('UPR',0)}/{done.get('DISP',0)}"
            )
        )
        self.generated_label.configure(
            text=(
                f"МДО: {counts.get('MDO',0)}\n"
                f"МСО: {counts.get('MSO',0)}\n"
                f"Управление: {counts.get('UPR',0)}\n"
                f"Диспетчеризация: {counts.get('DISP',0)}"
            )
        )
        self.phase_var.set(self._current_phase())
        self.stats_label.configure(
            text=(
                f"Команд: {stats.total_commands}\n"
                f"Выполнено: {sum(done.values())}\n"
                f"HIT: {stats.hits}\n"
                f"MISS: {stats.misses}\n"
                f"Hit rate: {stats.hit_rate():.1%}\n"
                f"ОП: {stats.op_accesses_words} слов\n"
                f"УСО: {stats.uso_accesses} обращений\n"
                f"СШ: {stats.bus_busy_sb_ticks} SB\n"
                f"МП: {self.sim.current_tick}\n"
                f"СШ: {self.sim.snapshot_dict()['tick_sb']}"
            )
        )
        self._set_text(self.log, "\n".join(self.sim.event_log[-20:]))
        self.status_var.set(f"tМП={self.sim.current_tick} | tСШ={self.sim.snapshot_dict()['tick_sb']} | FIFO={len(self.sim.bus.fifo)}")
        if auto_scroll:
            self.after_idle(self._scroll_to_current)

    def _scroll_to_current(self):
        if self.sim is None:
            return
        visible = max(1, self.timeline.winfo_width() - self.timeline.left_label_width - 40)
        x = self.timeline._x(self.sim.current_tick)
        target = max(0.0, (x - self.timeline.left_label_width - visible * 0.55) / max(1, self.timeline._last_width - visible))
        self.timeline.canvas.xview_moveto(min(1.0, target))

    @staticmethod
    def _set_text(widget: tk.Text, text: str):
        widget.configure(state="normal")
        widget.delete("1.0", "end")
        widget.insert("1.0", text)
        widget.configure(state="disabled")

    def _event_clicked(self, ev: ResourceEvent):
        task = TASK_NAMES.get(ev.task, ev.task or "—")
        cmd = f"{task} #{ev.command_id}" if ev.command_id is not None else "—"
        detail = (
            f"Ресурс: {dict(LANES)[ev.resource]}\n"
            f"Операция: {ev.operation}\n"
            f"Команда: {cmd}\n"
            f"Начало: {float(ev.start):g} такт МП\n"
            f"Конец: {float(ev.end):g} такт МП\n"
            f"Длительность: {float(ev.duration):g} такта МП\n"
            f"\n{ev.detail}"
        )
        self._set_text(self.detail, detail)

    def _on_close(self):
        self.pause_run()
        self.destroy()


if __name__ == "__main__":
    LabApp().mainloop()
